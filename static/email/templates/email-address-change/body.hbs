{{> header title="Verifica tu nuevo correo electrónico" }}

<mj-section background-color="#fafafa">
    <mj-column>
        <mj-text color="#525252">
            Recibimos una solicitud para cambiar tu correo registrado por este.
            Haz clic en el botón para verificarlo y completar el cambio:
        </mj-text>

        <mj-button font-family="Helvetica"
                   background-color="#f45e43"
                   color="white"
                   href="{{ changeEmailAddressUrl }}?token={{ identifierChangeToken }}">
            Verificar mi correo
        </mj-button>
    </mj-column>
</mj-section>


{{> footer }}
