# Application
APP_ENV=dev
PORT=3000
COOKIE_SECRET=change-me

# Superadmin (initial bootstrap only)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

# PostgreSQL (local: la contrasena se fija al crear el volumen, ver local-setup.md)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=vendure

#redis
 REDIS_HOST=localhost
 REDIS_PORT=6380
 REDIS_PASSWORD=

 #worker
 WORKER_HEALTH_PORT=3020

# Cloudflare R2 (assets)
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="Store <noreply@example.com>"

# Storefront
STOREFRONT_URL=http://localhost:4200
